# ===========================================
# MCP-KiCad Configuration Example
# ===========================================
# Copy this file to .env and customize values
# All settings are optional - defaults will be used if not specified

# ===========================================
# Authentication
# ===========================================
# Anthropic API Key for Claude client (required for client only)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ===========================================
# Logging Configuration
# ===========================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
MCP_KICAD_LOG_LEVEL=INFO

# Enable JSON formatted logs (useful for log aggregation)
MCP_KICAD_LOG_JSON=false

# Enable file logging
MCP_KICAD_LOG_TO_FILE=true

# Enable console logging
MCP_KICAD_LOG_TO_CONSOLE=true

# Log rotation size in MB (default: 10)
MCP_KICAD_LOG_ROTATION_MB=10

# Log retention in days (default: 7)
MCP_KICAD_LOG_RETENTION_DAYS=7

# ===========================================
# KiCad Integration
# ===========================================
# Use KiCad Flatpak installation
MCP_KICAD_USE_FLATPAK=false

# Expected KiCad version
MCP_KICAD_KICAD_VERSION=9.0

# Path to KiCad executable (auto-detected if not specified)
# MCP_KICAD_KICAD_EXECUTABLE=/usr/bin/kicad

# ===========================================
# Server Settings
# ===========================================
# Server name identifier
MCP_KICAD_SERVER_NAME=kicad-mcp-server

# Maximum concurrent operations
MCP_KICAD_MAX_CONCURRENT_OPERATIONS=10

# Operation timeout in seconds
MCP_KICAD_OPERATION_TIMEOUT_SECONDS=300

# ===========================================
# Board Constraints
# ===========================================
# Maximum board size in millimeters
MCP_KICAD_MAX_BOARD_SIZE_MM=1000.0

# Maximum number of components per board
MCP_KICAD_MAX_COMPONENTS=10000

# ===========================================
# File Export Settings
# ===========================================
# Base directory for exports
# MCP_KICAD_EXPORT_BASE_DIR=./exports

# Add timestamps to export directories
MCP_KICAD_CREATE_TIMESTAMPED_EXPORTS=true

# Create ZIP archives for fabrication packages
MCP_KICAD_ZIP_EXPORTS=true

# ===========================================
# Visual Verification
# ===========================================
# Enable screenshot capture for visual feedback
MCP_KICAD_ENABLE_VISUAL_VERIFICATION=true

# Screenshot dimensions
MCP_KICAD_SCREENSHOT_WIDTH=1600
MCP_KICAD_SCREENSHOT_HEIGHT=1200

# Screenshot JPEG quality (1-100)
MCP_KICAD_SCREENSHOT_QUALITY=85

# Directory for screenshots
# MCP_KICAD_SCREENSHOT_DIR=./screenshots

# ===========================================
# History & State Management
# ===========================================
# Maximum operations to keep in history
MCP_KICAD_MAX_HISTORY_SIZE=50

# Enable undo/redo functionality
MCP_KICAD_ENABLE_UNDO=true

# Persist history to disk
MCP_KICAD_PERSIST_HISTORY=false

# Path to history database
# MCP_KICAD_HISTORY_DB_PATH=./.mcp_kicad_history.db

# ===========================================
# Security Settings
# ===========================================
# Whitelist of allowed project directories (comma-separated)
# Empty = allow all paths (NOT recommended for production)
# MCP_KICAD_ALLOWED_PROJECT_PATHS=/home/user/kicad_projects,/opt/kicad

# Allow execution of external commands
MCP_KICAD_ALLOW_EXTERNAL_COMMANDS=false

# ===========================================
# Development & Debug
# ===========================================
# Enable debug mode (verbose logging)
MCP_KICAD_ENABLE_DEBUG=false

# Force mock mode even if KiCad is available
MCP_KICAD_ENABLE_MOCK_MODE=false

# ===========================================
# Performance Tuning
# ===========================================
# Enable caching of board information
MCP_KICAD_ENABLE_CACHING=true

# Cache TTL in seconds (0 = no expiration)
MCP_KICAD_CACHE_TTL_SECONDS=60
